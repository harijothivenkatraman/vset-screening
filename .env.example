# ==============================================================================
# vSET Production Environment Configuration (.env)
# ==============================================================================

# Public domain name for Caddy automatic HTTPS or local testing.
# - Production: vset.yourdomain.com (Caddy obtains and renews TLS certs automatically)
# - Local test: http://localhost
DOMAIN=http://localhost

# PostgreSQL Database password for user 'vset'.
# Generate a strong 24-byte hex secret using:
#   openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-secure-random-db-password

# Secret API key required for POST /api/v1/reports/import.
# In production, must be at least 32 characters and cannot match insecure default patterns.
# Generate a strong 32-byte hex secret using:
#   openssl rand -hex 32
IMPORT_API_KEY=replace-with-a-secure-random-32-byte-hex-string

# Allowed CORS origins in JSON list format.
# With Caddy serving the frontend and proxying /api/*, frontend requests are same-origin.
# Set to empty list [] to disallow cross-origin requests, or specify trusted domains:
#   CORS_ORIGINS=[]
#   CORS_ORIGINS=["https://dashboard.example.com"]
CORS_ORIGINS=[]

# Application runtime environment: "production" or "development".
# In production mode, security guards fail closed if keys are short or insecure.
ENVIRONMENT=production

# Number of Uvicorn worker processes.
# Recommended: 1 for a 2 GB RAM server (Lightsail/EC2).
WEB_CONCURRENCY=1

# Optional HTTP Basic Authentication to gate the entire site.
# Leave empty to serve without authentication.
# If enabled, specify username and bcrypt hash generated by Caddy:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext "YourPassword"
#
# NOTE FOR DOCKER COMPOSE:
# Docker Compose uses '$' for variable substitution. Any '$' inside the bcrypt
# hash MUST be escaped with double '$$'.
# Example:
#   Hash output: $2a$14$ZkO...
#   In .env:     BASIC_AUTH_HASH=$$2a$$14$$ZkO...
BASIC_AUTH_USER=
BASIC_AUTH_HASH=

# ── Company Discovery Feature ──
DISCOVERY_ENABLED=true
SEARCH_PROVIDERS=["searxng","duckduckgo"]
SEARXNG_BASE_URL=http://100.x.x.x:8888
LLM_BASE_URL=http://100.x.x.x:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=300
LLM_PROFILE=light
CACHE_TTL=3600
SCRAPER_MIN_INTERVAL=3.0
IMAGE_PROXY_ALLOWED_HOSTS=["media.licdn.com","static.licdn.com"]
DISCOVERY_MAX_JOBS_STORED=20
DISCOVERY_MAX_EVIDENCE_SIZE_MB=5
DISCOVERY_RATE_LIMIT_PER_HOUR=5
DISCOVERY_MIN_FREE_DISK_GB=2.0
# Apify token for Actor 'harvestapi/linkedin-profile-scraper' ($4 per 1k profiles).
# If unset, falls back to direct unauthenticated scraping.
APIFY_TOKEN=

# Bright Data API token (or BRIGHTDATA_API_KEY) for Bright Data LinkedIn Scraper API.
# If set, used as the primary managed scraper.
BRIGHTDATA_API_TOKEN=
