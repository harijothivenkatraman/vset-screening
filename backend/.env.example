DATABASE_URL=sqlite+aiosqlite:///./vset.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://vset:postgres_password@db:5432/vset
IMPORT_API_KEY=generate_with_openssl_rand_hex_32_in_prod
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "*"]

# ── Discovery Feature ──
DISCOVERY_ENABLED=true
SEARCH_PROVIDERS=["searxng","duckduckgo"]
SEARXNG_BASE_URL=http://100.x.x.x:8888
LLM_BASE_URL=http://100.x.x.x:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=300
LLM_PROFILE=light
CACHE_TTL=3600
SCRAPER_MIN_INTERVAL=3.0
IMAGE_PROXY_ALLOWED_HOSTS=["media.licdn.com","static.licdn.com"]
DISCOVERY_MAX_JOBS_STORED=20
DISCOVERY_MAX_EVIDENCE_SIZE_MB=5
DISCOVERY_RATE_LIMIT_PER_HOUR=5
DISCOVERY_MIN_FREE_DISK_GB=2.0
